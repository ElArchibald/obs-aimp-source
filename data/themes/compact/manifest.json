    "timeWeight": 400
  },
  "colors": {
    "background": "#14151EE6",
    "border": "#2E314499",
    "borderWidth": 1.5,
    "titleText": "#FFFFFF",
    "artistText": "#99A0B8",
    "timeText": "#7E859E",
    "progressBackground": "#22253380",
    "progressFill": "#3D7BFF",
    "progressFillEnd": "#68A5FF",
