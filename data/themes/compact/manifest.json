{
  "id": "compact",
  "name": "Streamer Compact Pill",
  "author": "Alex",
  "version": "1.0.0",
  "description": "Minimalist streamlined horizontal pill layout for discreet broadcast overlays",
  "layout": {
    "width": 440,
    "height": 72,
    "cornerRadius": 36,
    "padding": 8,
