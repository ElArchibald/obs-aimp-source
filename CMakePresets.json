{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "template",
      "hidden": true,
      "cacheVariables": {
        "ENABLE_FRONTEND_API": true,
        "ENABLE_QT": true
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (Ninja)",
      "description": "Build for Windows x64 with Ninja",
      "inherits": ["template"],
      "binaryDir": "${sourceDir}/build",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Ninja",
      "warnings": {"dev": true, "deprecated": true},
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "windows-vs",
      "displayName": "Windows x64 (Visual Studio 2026)",
      "description": "Build for Windows x64 with Visual Studio 18 2026 IDE",
      "inherits": ["template"],
      "binaryDir": "${sourceDir}/build_vs",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "warnings": {"dev": true, "deprecated": true}
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "displayName": "Windows x64 (Ninja)",
      "description": "Windows build for x64 with Ninja",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-vs",
      "configurePreset": "windows-vs",
      "displayName": "Windows x64 (Visual Studio 2026)",
      "description": "Windows build for x64 with Visual Studio 18 2026",
      "configuration": "RelWithDebInfo"
    }
  ]
}
